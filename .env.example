# Configuración del servidor
PORT=3000

# Supabase (PostgreSQL)
# 1. Crear proyecto en https://supabase.com
# 2. Ir a Project Settings > API
# 3. Copiar Project URL como SUPABASE_URL
# 4. Copiar service_role secret como SUPABASE_SERVICE_ROLE_KEY
# 5. Ejecutar db/schema.sql en SQL Editor de Supabase
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# WhatsApp Cloud API (Meta)
# 1. Ir a https://developers.facebook.com → crear app de tipo "Business"
# 2. Agregar producto "WhatsApp Cloud API"
# 3. Copiar "Phone Number ID" y "Permanent Access Token"
# 4. WHATSAPP_RECIPIENT = número del dueño (ej: 541112345678, con código país sin +)
WHATSAPP_TOKEN=tu-permanent-access-token
WHATSAPP_PHONE_NUMBER_ID=tu-phone-number-id
WHATSAPP_RECIPIENT=54123456789
